# Copy to .env and fill in. Step 2 doesn't read any of these yet — they're here
# so the values are ready when the agent + voice steps land.

# Port this service listens on.
PORT=8000

# Groq (LLM brain for the interview agent) — added in the LangGraph step.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ElevenLabs (interviewer voice / TTS) — added in the voice step.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Shared secret the Node gateway sends so only it can call this service.
INTERNAL_API_KEY=
