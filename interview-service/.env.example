# Copy to .env (gitignored) and fill in your real values there — NOT here.
# This template is committed to git, so it must never contain secrets.

# Port this service listens on.
PORT=8000

# Groq (LLM brain for the interview agent).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Shared secret the Node gateway sends (X-Internal-Key) so only it can call this
# service. Must match INTERNAL_API_KEY in backend/.env (leave blank in dev).
INTERNAL_API_KEY=
